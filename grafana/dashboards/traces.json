{
  "uid": "traces",
  "title": "3 \u00b7 Traces - where did the time go?",
  "description": "Chapter 3: one request, step by step, with a clock. The slow span has a name; the failed trace has a gap.",
  "tags": [
    "week8"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "0 \u00b7 Up",
      "type": "link",
      "url": "/d/up"
    },
    {
      "title": "1 \u00b7 Metrics",
      "type": "link",
      "url": "/d/metrics"
    },
    {
      "title": "2 \u00b7 Logs",
      "type": "link",
      "url": "/d/logs"
    },
    {
      "title": "3 \u00b7 Traces",
      "type": "link",
      "url": "/d/traces"
    },
    {
      "title": "Shop - all three",
      "type": "link",
      "url": "/d/shop"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Slow requests - traces longer than 50 mss (click a trace ID)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "TraceQL: root spans from the shop that took over a second. Open one and look at the SQL span.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"app\" && duration > 50ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Failed requests - traces with an error (click one: what is missing?)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "TraceQL: traces where a span failed. During an incident the catalogue span is simply absent - nobody answered.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 3,
      "type": "nodeGraph",
      "title": "Service map - who calls whom, derived from the traces",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Tempo turns the spans into metrics (request rate, errors, latency per edge) and Grafana draws the graph.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "serviceMap"
        }
      ],
      "options": {
        "nodes": {
          "mainStatUnit": "ms"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests per second between services - from the spans",
      "description": "Tempo's metrics-generator counts calls between services and writes them to Prometheus - traces feeding the metrics pillar.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total[1m]))",
          "legendFormat": "{{client}} \u2192 {{server}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
